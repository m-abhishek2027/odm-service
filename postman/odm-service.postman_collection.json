{
  "info": {
    "name": "odm-service",
    "description": "ODM digital asset metadata API. Set baseUrl to the local server or the Cloud Run URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "uuid",
      "value": "1fa365d8-3dd4-42ef-a463-5993aed9479a"
    }
  ],
  "item": [
    {
      "name": "Lookup (AEM)",
      "item": [
        {
          "name": "Lookup - single (FOUND)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-test-001"
              }
            ],
            "url": "{{baseUrl}}/api/v1/digitalAsset/lookup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assets\": [\n    {\n      \"referenceId\": \"aem-asset-001\",\n      \"fileName\": \"13cb25186_01_009.jpg\",\n      \"source\": \"external\",\n      \"supplier\": \"autocomp\",\n      \"brand\": \"bosch\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Lookup - populated asset (FOUND, all AEM fields)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-test-003"
              }
            ],
            "url": "{{baseUrl}}/api/v1/digitalAsset/lookup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assets\": [\n    {\n      \"referenceId\": \"aem-asset-010\",\n      \"fileName\": \"BC905_front.jpg\",\n      \"source\": \"External\",\n      \"supplier\": \"AutoComp\",\n      \"brand\": \"Bosch\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Lookup - batch (every status: FOUND, DUPLICATE, NOT_FOUND, INVALID, DELETED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "postman-test-002"
              }
            ],
            "url": "{{baseUrl}}/api/v1/digitalAsset/lookup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assets\": [\n    {\n      \"referenceId\": \"aem-asset-001\",\n      \"fileName\": \"13cb25186_01_009.jpg\",\n      \"source\": \"external\",\n      \"supplier\": \"autocomp\",\n      \"brand\": \"bosch\"\n    },\n    {\n      \"referenceId\": \"aem-asset-002\",\n      \"fileName\": \"11cb25125_02_002.jpg\",\n      \"source\": \"external\",\n      \"supplier\": \"autocomp\",\n      \"brand\": \"bosch\"\n    },\n    {\n      \"referenceId\": \"aem-asset-003\",\n      \"fileName\": \"img_0000.gif\",\n      \"source\": \"external\",\n      \"supplier\": \"autocomp\",\n      \"brand\": \"bosch\"\n    },\n    {\n      \"referenceId\": \"aem-asset-004\",\n      \"fileName\": \"sunset-1.jpeg\",\n      \"source\": \"source\",\n      \"supplier\": \"supplier\",\n      \"brand\": \"Adidas\"\n    },\n    {\n      \"referenceId\": \"aem-asset-005\",\n      \"fileName\": \"0bck4ymbo.jpg\",\n      \"source\": \"external\",\n      \"brand\": \"delphi\"\n    },\n    {\n      \"referenceId\": \"aem-asset-006\",\n      \"fileName\": \"deleted-test-asset.jpg\",\n      \"source\": \"test\",\n      \"supplier\": \"odm-test\",\n      \"brand\": \"test-brand\"\n    }\n  ]\n}"
