    },
    {
      "name": "Digital assets",
      "item": [
        {
          "name": "Get all (filters + paging)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/digitalAsset?offset=0&limit=20&active=true&source=external&supplier=autocomp&brand=bosch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "digitalAsset"
              ],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "active",
                  "value": "true"
                },
                {
                  "key": "source",
                  "value": "external"
                },
                {
                  "key": "supplier",
                  "value": "autocomp"
                },
                {
                  "key": "brand",
                  "value": "bosch"
                },
                {
                  "key": "origAssetName",
                  "value": "11cb25125_02_002.jpg",
                  "disabled": true
                },
                {
                  "key": "assetName",
                  "value": "13cb",
                  "disabled": true
                },
                {
                  "key": "createdOnFrom",
                  "value": "2026-10-01T00:00:00",
                  "disabled": true
                },
                {
                  "key": "createdOnTo",
                  "value": "2026-12-31T23:59:59",
                  "disabled": true
                },
                {
                  "key": "createdBy",
                  "value": "gcs-import",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get by UUID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/digitalAsset/{{uuid}}"
          }
        },
        {
          "name": "Add asset(s)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "postman"
              }
            ],
            "url": "{{baseUrl}}/api/v1/digitalAsset",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"source\": \"internal-pim\",\n    \"supplier\": \"Adidas AG\",\n    \"brand\": \"Adidas\",\n    \"assetName\": \"running-shoe-hero.jpg\",\n    \"origAssetName\": \"running-shoe-hero.jpg\",\n    \"title\": \"Running Shoe Hero\",\n    \"description\": \"Hero banner for SS26 campaign\",\n    \"assetType\": \"stills\",\n    \"colorSpace\": \"RGB\",\n    \"language\": [\"en\"],\n    \"productRegion\": [\"na\"],\n    \"channelName\": [\"digital\"],\n    \"productLine\": [\"running\"],\n    \"productCategory\": [\"footwear\"]\n  }\n]"
            }
          }
        },
        {
          "name": "Update by UUID (blank fields are ignored)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "aem"
              }
            ],
            "url": "{{baseUrl}}/api/v1/digitalAsset/{{uuid}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origFileType\": \"TIFF\",\n  \"adjFileType\": \"JPEG\",\n  \"fileSource\": \"External\",\n  \"origPixelSizeWidth\": 4000,\n  \"origPixelSizeHeight\": 3000,\n  \"adjPixelSizeWidth\": 2000,\n  \"adjPixelSizeHeight\": 1500,\n  \"dpi\": 300,\n  \"fileSizeInKB\": 845.6,\n  \"isLayered\": false,\n  \"hasWatermark\": false,\n  \"okThumb\": true,\n  \"okSmall\": true,\n  \"okMedium\": true,\n  \"okLarge\": true,\n  \"okExtraLarge\": false,\n  \"okWhitespace\": true,\n  \"okLightDark\": true,\n  \"colorSpace\": \"RGB\",\n  \"dateProcessed\": \"2026-10-23T10:30:00\",\n  \"title\": \"\",\n  \"description\": null\n}"
            }
          }
        },
        {
          "name": "Soft delete by UUID",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-User-Id",
                "value": "postman"
              }
            ],
            "url": "{{baseUrl}}/api/v1/digitalAsset/{{uuid}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "GCS import - dry run",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/import/gcs?dryRun=true"
          }
        },
        {
          "name": "GCS import - run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "gcs-import"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/import/gcs"
          }
        },
        {
          "name": "DB index status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/admin/db/indexes"
          }
        },
        {
          "name": "DB create missing indexes",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/admin/db/indexes"
          }
        }
      ]
    }
  ]
}